{
  "name": "nebula-git",
  "productName": "Nebula",
  "version": "0.2.0",
  "description": "A free, open-source alternative to GitKraken: a fast, good-looking Git client for macOS, Windows and Linux.",
  "keywords": [
    "git",
    "git-client",
    "gitkraken-alternative",
    "electron",
    "macos",
    "windows",
    "linux",
    "github",
    "gitlab",
    "merge-conflicts"
  ],
  "homepage": "https://github.com/ryolay/nebula#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryolay/nebula.git"
  },
  "bugs": {
    "url": "https://github.com/ryolay/nebula/issues"
  },
  "author": {
    "name": "Christian Da Silva Perez",
    "email": "28789550+ryolay@users.noreply.github.com"
  },
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test --test-concurrency=1 tests/backend.test.js tests/graph.test.js tests/identity.test.js tests/ssh.test.js tests/power.test.js tests/issues.test.js tests/pr.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "lint": "eslint . && stylelint \"src/**/*.css\" && markdownlint-cli2 \"*.md\" \".github/**/*.md\" && jscpd src --min-tokens 60 --threshold 3 --silent",
    "screenshots": "node scripts/screenshots.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test:portable": "node --test --test-concurrency=1 tests/backend.test.js tests/graph.test.js tests/identity.test.js tests/power.test.js",
    "postdist": "npm run rebuild:native",
    "postdist:mac": "npm run rebuild:native"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jscpd": "^4.3.0",
    "markdownlint-cli2": "^0.18.1",
    "stylelint": "^16.26.1"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "node-pty@1.1.0": true,
    "electron-winstaller": false
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "build": {
    "appId": "dev.nebula.git",
    "productName": "Nebula",
    "copyright": "Copyright © 2026 Christian Da Silva Perez",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Christian Da Silva Perez <28789550+ryolay@users.noreply.github.com>",
      "synopsis": "A free, open-source Git client"
    },
    "publish": null
  }
}
